# Production deployment URL — the single most important URL in this app.
# Reflex uses it for API/websocket URLs, AND it is the canonical base for:
#   - Open Graph / Twitter Card meta tags (link previews)
#   - Share & Report links, QR codes, PDF exports
#   - Sculpture email permalinks
#   - Sitemap, robots.txt, llms.txt canonical URLs
# Comment out for local dev (falls back to http://localhost:3000).
DEPLOY_URL=https://enhancement.bio
REFLEX_API_URL=https://enhancement.bio

# Maximum WebSocket message size in bytes. The report publish callback sends
# base64 PNG+PDF data (~3-10 MB) through WebSocket. Reflex default is 1 MB
# which silently drops large messages. 50 MB is safe for report bundles.
REFLEX_SOCKET_MAX_HTTP_BUFFER_SIZE=50000000
# Resend transactional email (https://resend.com). Used by the "Send to email"
# buttons on the sculpture and jigsaw pages.
#   RESEND_API_KEY     — API key (starts with `re_`).
#   RESEND_FROM_EMAIL  — verified sender, e.g. "Name <noreply@yourdomain.com>".
#                        Defaults to Resend's shared sandbox sender so the
#                        button works out of the box without DNS setup.
#   RESEND_REPLY_TO    — optional reply-to address (a real human inbox).
RESEND_API_KEY=re_xxxxxxx
RESEND_FROM_EMAIL=Materialized Enhancements <no-reply@longevity-genie.info>
RESEND_REPLY_TO=
# ARTEX Platform API integration (see src/materialized_enhancements/artex.py)
# ARTEX_API_URL: base URL for the platform API server (no trailing slash, no /v1).
# ARTEX_API_TOKEN: the ARTEX_PLATFORM_ADMIN_TOKEN value configured on the API server.
#   This is exchanged for a short-lived session token at publish time.
# ARTEX_DISPLAY_ID: venue display ID to push artwork to when the ARTEX button is clicked.
#   Overridden at runtime by ?display_id=<id> query parameter.
ARTEX_API_URL=http://127.0.0.1:8787
ARTEX_API_TOKEN=abcd
ARTEX_DISPLAY_ID=test-wall

# Optional post-materialization community CTA. Shown only after a visitor
# generates their materialization artifacts. Leave unset for the built-in
# default, set a full invite URL to override, or set DISCORD_INVITE_URL= to hide.
# DISCORD_INVITE_URL=
DISCORD_COMMUNITY_NAME=enhancement.bio Discord
# Optional GitHub feedback/star CTA in the same post-generation area. Set empty to hide.
GITHUB_PROJECT_URL=https://github.com/longevity-genie/materialized-enhancements
# Optional donation CTA in the same post-generation area. Set empty to hide.
DONATION_URL=https://ko-fi.com/liviazaharia

# Kiosk inactivity redirect URL — the page the kiosk returns to when the idle
# timer expires. The timer is only active when ?redirect=<url> is in the page URL;
# that query param takes precedence over this env value.
ARTEX_IDLE_URL=https://artex.live/

# Dev-only: when MATERIALIZED_DEV_MODE=1 the idle timer and post-publish redirects
# go here instead. Supports {slug} substitution.
ARTEX_DEV_REDIRECT_URL=http://127.0.0.1:8787/public/projects/{slug}

# Kiosk idle timer duration. The timer is rendered and active only when the
# page URL contains ?redirect=<url>. IDLE_WARNING_SECONDS controls how many
# seconds before the end the band turns red.
IDLE_TIMEOUT_SECONDS=60
IDLE_WARNING_SECONDS=5

# Production server port. In fullstack prod mode Reflex serves both frontend
# and backend on one port. Set this so Caddy reverse-proxy mappings stay fixed.
# Leave blank to use the Reflex default (3000 if available, auto-increment if busy).
APP_PORT=3001

# Umami analytics (https://umami.is). Both vars must be set to enable tracking;
# leave blank to disable (safe for local dev).
#   UMAMI_SCRIPT_URL — full URL to /script.js on your self-hosted Umami instance.
#   UMAMI_WEBSITE_ID — UUID from Umami Settings → Websites.
#   UMAMI_DOMAINS   — comma-separated production hostnames (e.g. "example.com").
#                     When set, Umami silently skips tracking on any other host,
#                     so localhost dev runs never pollute your production stats.
#                     Leave blank to track all hostnames (not recommended for prod).
#   UMAMI_HOST_URL  — where the tracker POSTs data. Point to a same-domain reverse
#                     proxy path (e.g. "https://example.com/stats") so the /api/send
#                     request is first-party and invisible to ad blockers.
#                     Caddy example inside your app's handle block:
#                       handle /stats/script.js { rewrite * /script.js; reverse_proxy localhost:3300 }
#                       handle /stats/api/* { reverse_proxy localhost:3300 }
UMAMI_SCRIPT_URL=https://your-app-domain.example.com/stats/script.js
UMAMI_WEBSITE_ID=
UMAMI_DOMAINS=
UMAMI_HOST_URL=https://your-app-domain.example.com/stats
